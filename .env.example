# Where the CLI sends API requests. May be a LAN/VPN address.
OUTLINE_URL=https://outline.example.com
# Base URL for links written into documents. Defaults to OUTLINE_URL.
# Set this when OUTLINE_URL is private, so links stay usable for everyone.
OUTLINE_PUBLIC_URL=
OUTLINE_API_KEY=ol_api_your_key_here
OUTLINE_COLLECTION_ID=your-collection-id
OBSIDIAN_FOLDER=/path/to/your/obsidian/vault
INDEX_AS_FOLDER=true
REMOVE_TOC=false
